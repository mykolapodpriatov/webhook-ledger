{
  "name": "webhook-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS 11 service on Fastify that accepts signed webhooks, stores each delivery once per tenant in Postgres, and reads them back in order.",
  "license": "MIT",
  "author": "Mykola Podpriatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykolapodpriatov/webhook-ledger.git"
  },
  "bugs": "https://github.com/mykolapodpriatov/webhook-ledger/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.11.3",
    "nestjs-zod": "^5.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.10.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.11"
  }
}
